{
  "name": "comicbooks-api",
  "version": "0.1.5",
  "description": "Look up comic albums on stripinfo.be by ISBN",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "jest --testPathIgnorePatterns /live/",
    "prepublishOnly": "npm run typecheck && npm run build",
    "test:live": "jest __test__/live"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yashkathe/Download-ComicBooks-API"
  },
  "keywords": [
    "comics",
    "comicbooks",
    "strips",
    "stripinfo",
    "isbn",
    "bande dessinee"
  ],
  "author": "Yash Kathe",
  "license": "GPL-3.0",
  "dependencies": {
    "axios": "^0.27.2",
    "cheerio": "^1.0.0-rc.12"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  }
}
